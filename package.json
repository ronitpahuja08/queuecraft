{
  "name": "queuecraft",
  "version": "0.1.0",
  "description": "A production-minded distributed job orchestration platform.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "dev": "tsx src/server.ts",
    "format": "biome format --write .",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "author": "Ronit Pahuja <ronitpahuja08@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
